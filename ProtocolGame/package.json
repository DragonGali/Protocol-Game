{
  "name": "protocol-game",
  "version": "1.0.0",
  "private": true,
  "main": "electron/electron.js",
  "scripts": {
    "dev": "vite",
    "electron:dev": "concurrently -k \"npm run dev\" \"cross-env IS_DEV=true electron .\"",
    "build:react": "vite build",
    "app:build": "npm run build:react && electron-builder"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^40.1.0",
    "electron-builder": "^26.7.0",
    "vite": "^7.1.2",
    "@vitejs/plugin-react": "^5.0.0"
  },
  "build": {
    "appId": "com.protocol.game",
    "productName": "Protocol Game",
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "directories": {
      "output": "C:/Users/magshimim/Desktop/ProtocolGameBuild"
    }
  },
  "asarUnpack": [
    "dist/public/**/*"
  ]
